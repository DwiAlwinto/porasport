# ─────────────────────────────────────────────────────────────
#  Contoh konfigurasi environment — SALIN ke `.env` lalu isi.
#  JANGAN pernah commit `.env` yang berisi nilai asli.
# ─────────────────────────────────────────────────────────────
#
#  Buat secret acak:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
#  Setiap secret yang ditandai WAJIB akan membuat aplikasi berhenti start
#  bila kosong. Ini disengaja: lebih baik gagal start daripada aplikasi
#  berjalan dengan kunci yang tertulis di source code.


# ── Supabase ──────────────────────────────────────────────────

# Wajib. URL proyek Supabase Anda.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Wajib. Kunci publishable (anon). Kunci ini memang aman_commit karena
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Wajib. Dipakai server untuk Storage & OCR. JANGAN dipakai di komponen client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx


# ── Database (Postgres via Supabase) ──────────────────────────

# Wajib. Connection string ke Prisma.
#
# PENTING: kalau password mengandung karakter '@', 'password', atau karakter
# reserved lain, WAJIB di-encode sebagai %40 / %3A. Contoh:
#   password Asli : HfasIT@2026
#   di URL        : HfasIT%402026
# Database yang tidak ter-encode bisa gagal connect atau, lebih buruk,
# tersambung ke host yang salah.
DATABASE_URL=postgresql://postgres.xxxxx:password%40disini@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Opsional. Koneksi langsung tanpa pooler, dipakai untuk migrasi.
DIRECT_URL=postgresql://postgres.xxxxx:password%40disini@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres


# ── Rahasia sesi (WAJIB) ──────────────────────────────────────

# Wajib, minimal 32 karakter. Mengganti nilai ini akan MEMBATALKAN semua
# sesi admin dan pengguna yang sedang berjalan.
SESSION_SECRET=hasil_random_bytes_48

# Wajib. Kalau dikosongkan, SESSION_SECRET yang dipakai.
USER_SESSION_SECRET=hasil_random_bytes_48


# ── Pembayaran ────────────────────────────────────────────────

# Wajib. Kunci yang dipakai untuk memverifikasi tanda tangan HMAC dari
# payment gateway di /api/payment/webhook. Tanpa ini, webhook menolak
# semua permintaan.
PAYMENT_WEBHOOK_SECRET=hasil_random_bytes_32


# ── Google Cloud Vision (OCR bukti pembayaran) ────────────────

# Wajib jika fitur OCR dipakai. Isi dengan SELURUH isi file JSON
# service account, dalam satu baris, dengan "\n" untuk line break:
GOOGLE_CLOUD_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}


# ── Google OAuth (login opsional) ─────────────────────────────

# Opsional. Tanpa ini, login Google dinonaktifkan dan hanya email/password
# yang bisa dipakai. Ambil dari https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# Wajib jika OAuth aktif. Callback URL:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com


# ── Cron job ──────────────────────────────────────────────────

# Wajib. Dipakai sebagai bearer token /api/cron/expire-bookings.
# Generate acak minimal 32 karakter.
CRON_SECRET=hasil_random_bytes_32


# ── URL aplikasi ──────────────────────────────────────────────

# Wajib untuk OAuth & callback webhook. Tanpa protocol pada produksi.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Bootstrap admin (opsional, hanya untuk script CLI) ─────────
#
# Dipakai oleh `npm run db:create-admin`. Tidak dibaca aplikasi langsung.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GantiDenganKataSandiKuat123!
ADMIN_NAME=Super Admin
ADMIN_ROLE=SUPERADMIN
